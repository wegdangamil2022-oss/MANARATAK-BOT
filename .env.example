# Example only. Runtime defaults to OFF and never loads credentials from this file.
BOT_ENV=development
BOT_OWNER_ID=123456789
BOT_ID=manaratak-bot-dev
BOT_USERNAME=ManaratakBot
BOT_STATE_FILE=./runtime/dev-state.json
TELEGRAM_ENABLED=false
TELEGRAM_REPLY_DELIVERY_ENABLED=false
# Required only for explicit production opt-in using an existing private SQLite:
# BOT_ENV=production
# BOT_STATE_FILE=/absolute/private/manaratak/state.sqlite
# TELEGRAM_BOT_TOKEN=<private-secrets-manager-value>
# TELEGRAM_WEBHOOK_SECRET=<private-random-32-character-plus-secret>
# TELEGRAM_LISTEN_PORT=8787
AI_ENABLED=false
TELEGRAM_DOCUMENT_DOWNLOAD_ENABLED=false
TELEGRAM_MINIAPP_ADMIN_ENABLED=false
