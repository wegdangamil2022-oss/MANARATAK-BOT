{
  "name": "manaratak-bot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "MANARATAK BOT B0/B1/B2-Core: simulation-only core, moderation and subscription policies",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm run typecheck && npm test",
    "demo": "npm run build && node dist/src/demo.js --simulate"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3"
  }
}