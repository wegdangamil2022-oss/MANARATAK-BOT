{
  "name": "manaratak-bot",
  "version": "0.4.8",
  "private": true,
  "type": "module",
  "description": "MANARATAK BOT B0-B4 mock-only: cancellation-safe multipart and immutable receipt/reservation safeguards",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm run typecheck && npm test",
    "demo": "npm run build && node dist/src/demo.js --simulate",
    "demo:education": "npm run build && node dist/src/education-demo.js",
    "demo:faq": "npm run build && node dist/src/faq-demo.js",
    "demo:publishing": "npm run build && node dist/src/publishing-demo.js",
    "demo:preview-migration": "npm run build && node dist/src/preview-migration-demo.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3"
  }
}
